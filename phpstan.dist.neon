# Extensions are included explicitly because Composer plugins
# (phpstan/extension-installer) are disabled in composer.json.
includes:
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    level: max
    phpVersion: 80512
    paths:
        - config.php
        - index.php
        - lang.php
        - lang
        - src
        - upload.php
    typeAliases:
        UpConfig: 'object{allowed_hosts: string, webroot: string, upload_dir: string, logs_dir: string, max_filesize: int, files_limit: int, ssl: bool, csp: bool, sri: bool, paranoya: bool, paranoya_host: string, paranoya_port: int}'
